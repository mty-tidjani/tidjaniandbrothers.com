generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadSource {
  AUDIT
  CONTACT
}

enum LeadStatus {
  NOUVEAU
  CONTACTE
  AUDIT_PLANIFIE
  CONVERTI
  PERDU
}

enum BlogCategory {
  ODOO
  DIGITALISATION
  ACTUALITES
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts        BlogPost[]
  leadNotes        LeadNote[]
  leadStatusEvents LeadStatusEvent[]
  passwordResets   PasswordResetToken[]
}

model Lead {
  id             String     @id @default(cuid())
  fullName       String
  company        String
  phone          String
  email          String
  sector         String
  servicesWanted String[]
  preferredSlot  String?
  message        String?
  source         LeadSource
  status         LeadStatus @default(NOUVEAU)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  notes        LeadNote[]
  statusEvents LeadStatusEvent[]

  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  body      String
  authorId  String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model LeadStatusEvent {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  actorId    String?
  createdAt  DateTime    @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String
  contentHtml     String
  coverImagePath  String?
  category        BlogCategory
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(DRAFT)
  authorId        String
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([category])
}

model CaseStudy {
  id           String   @id @default(cuid())
  slug         String   @unique
  sector       String
  before       String
  after        String
  resultMetric String?
  imagePaths   String[]
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceTier {
  id            String  @id @default(cuid())
  name          String
  priceMin      Int
  priceMax      Int?
  currency      String  @default("FCFA")
  features      String[]
  maxUsers      String?
  isMaintenance Boolean @default(false)
  sortOrder     Int     @default(0)
}

model CompanySettings {
  id            String   @id @default(cuid())
  phone         String
  email         String
  address       String
  facebookUrl   String?
  defaultLocale String   @default("fr")
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id         String    @id @default(cuid())
  email      String
  role       Role      @default(EDITOR)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}
