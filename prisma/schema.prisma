generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadSource {
  AUDIT
  CONTACT
}

enum LeadStatus {
  NOUVEAU
  CONTACTE
  AUDIT_PLANIFIE
  CONVERTI
  PERDU
}

enum QuoteStatus {
  BROUILLON
  SOUMIS
  DEVIS_ENVOYE
  CONVERTI
  PERDU
}

enum BlogCategory {
  ODOO
  DIGITALISATION
  ACTUALITES
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts         BlogPost[]
  leadNotes         LeadNote[]
  leadStatusEvents  LeadStatusEvent[]
  passwordResets    PasswordResetToken[]
  quoteStatusEvents QuoteStatusEvent[]

  smsAccountStatusEvents  SmsAccountStatusEvent[]
  smsSenderIdStatusEvents SmsSenderIdStatusEvent[]
  smsCreditTransactions   SmsCreditTransaction[]
}

model Lead {
  id             String     @id @default(cuid())
  fullName       String
  company        String
  phone          String
  email          String
  sector         String
  servicesWanted String[]
  preferredSlot  String?
  message        String?
  source         LeadSource
  status         LeadStatus @default(NOUVEAU)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  notes        LeadNote[]
  statusEvents LeadStatusEvent[]

  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  body      String
  authorId  String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model LeadStatusEvent {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  actorId    String?
  createdAt  DateTime    @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
}

model QuoteRequest {
  id          String      @id @default(cuid())
  sessionId   String      @unique
  status      QuoteStatus @default(BROUILLON)
  currentStep Int         @default(1)
  answers     Json        @default("{}")

  companyName     String?
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  budgetMentioned String?

  proposedAmount Int?
  internalNote   String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statusEvents QuoteStatusEvent[]

  @@index([status])
  @@index([updatedAt])
}

model QuoteStatusEvent {
  id         String       @id @default(cuid())
  quoteId    String
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  actorId    String?
  createdAt  DateTime     @default(now())

  quote QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id])
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String
  contentHtml     String
  coverImagePath  String?
  category        BlogCategory
  metaTitle       String?
  metaDescription String?
  status          ContentStatus @default(DRAFT)
  authorId        String
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([status])
  @@index([category])
}

model CaseStudy {
  id           String   @id @default(cuid())
  slug         String   @unique
  sector       String
  before       String
  after        String
  resultMetric String?
  imagePaths   String[]
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ServiceTier {
  id            String   @id @default(cuid())
  name          String
  priceMin      Int
  priceMax      Int?
  currency      String   @default("FCFA")
  features      String[]
  maxUsers      String?
  isMaintenance Boolean  @default(false)
  sortOrder     Int      @default(0)
}

model CompanySettings {
  id            String   @id @default(cuid())
  phone         String
  email         String
  address       String
  facebookUrl   String?
  defaultLocale String   @default("fr")
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id         String    @id @default(cuid())
  email      String
  role       Role      @default(EDITOR)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// SMS reselling (upstream provider: 1s2u). See SMS.md.
// One credit = one SMS part to the reference corridor (Cameroon). Other
// destinations cost `SmsRateCard.creditsPerPart` credits per part.
// ---------------------------------------------------------------------------

enum SmsAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SmsSenderIdStatus {
  PENDING_REVIEW
  APPROVED
  BLOCKED
  REJECTED
}

enum SmsCreditTxnType {
  TOPUP
  DEBIT
  REFUND
  ADJUSTMENT
}

enum SmsMessageStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
}

enum SmsEncoding {
  GSM7
  UNICODE
}

model SmsAccount {
  id            String           @id @default(cuid())
  companyName   String
  contactName   String
  contactEmail  String           @unique
  contactPhone  String
  status        SmsAccountStatus @default(PENDING)
  creditBalance Int              @default(0)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  senderIds    SmsSenderId[]
  apiKeys      SmsApiKey[]
  messages     SmsMessage[]
  transactions SmsCreditTransaction[]
  statusEvents SmsAccountStatusEvent[]
  portalUsers  SmsPortalUser[]

  @@index([status])
}

model SmsAccountStatusEvent {
  id         String            @id @default(cuid())
  accountId  String
  fromStatus SmsAccountStatus?
  toStatus   SmsAccountStatus
  reason     String?
  actorId    String?
  createdAt  DateTime          @default(now())

  account SmsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actor   User?      @relation(fields: [actorId], references: [id])
}

model SmsSenderId {
  id           String            @id @default(cuid())
  // Exactly as it will be displayed on handsets.
  value        String
  // Uppercased `value`: uniqueness is case-insensitive so "MyBank" and
  // "MYBANK" can't be registered by two different customers.
  normalized   String            @unique
  accountId    String
  status       SmsSenderIdStatus @default(PENDING_REVIEW)
  statusReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  account      SmsAccount               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apiKeys      SmsApiKey[]
  messages     SmsMessage[]
  statusEvents SmsSenderIdStatusEvent[]

  @@index([status])
  @@index([accountId])
}

model SmsSenderIdStatusEvent {
  id         String             @id @default(cuid())
  senderIdId String
  fromStatus SmsSenderIdStatus?
  toStatus   SmsSenderIdStatus
  reason     String?
  actorId    String?
  createdAt  DateTime           @default(now())

  senderId SmsSenderId @relation(fields: [senderIdId], references: [id], onDelete: Cascade)
  actor    User?       @relation(fields: [actorId], references: [id])
}

// Each key is bound to exactly one sender ID. A sender ID may have several
// keys over time so a leaked key can be rotated without re-registering it.
model SmsApiKey {
  id         String    @id @default(cuid())
  accountId  String
  senderIdId String
  label      String
  // First characters of the secret, shown in the admin UI to identify it.
  keyPrefix  String
  // SHA-256 of the full secret. Keys are 256-bit random, so a fast hash is
  // safe here and lets us look a key up in O(1) on every request.
  keyHash    String    @unique
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  account  SmsAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  senderId SmsSenderId  @relation(fields: [senderIdId], references: [id], onDelete: Cascade)
  messages SmsMessage[]

  @@index([accountId])
}

model SmsMessage {
  id                 String           @id @default(cuid())
  accountId          String
  apiKeyId           String?
  senderIdId         String
  senderValue        String
  recipients         String[]
  body               String
  encoding           SmsEncoding
  parts              Int
  creditsCharged     Int
  creditsRefunded    Int              @default(0)
  // Our estimated cost at 1s2u for the parts actually submitted.
  upstreamCostFcfa   Int              @default(0)
  status             SmsMessageStatus @default(PENDING)
  upstreamMessageIds String[]
  errorCode          String?
  // One entry per ≤30-recipient upstream batch: { recipients, ok, upstreamId?, errorCode? }.
  batches            Json             @default("[]")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  account      SmsAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apiKey       SmsApiKey?             @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  senderId     SmsSenderId            @relation(fields: [senderIdId], references: [id], onDelete: Cascade)
  transactions SmsCreditTransaction[]

  @@index([accountId, createdAt])
  @@index([status])
}

model SmsCreditTransaction {
  id           String           @id @default(cuid())
  accountId    String
  type         SmsCreditTxnType
  // Positive for TOPUP/REFUND, negative for DEBIT, either sign for ADJUSTMENT.
  credits      Int
  balanceAfter Int
  // What the customer paid us, for TOPUP rows. Drives the margin report.
  amountFcfa   Int?
  packageId    String?
  messageId    String?
  note         String?
  actorId      String?
  createdAt    DateTime         @default(now())

  account SmsAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  package SmsPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  message SmsMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  actor   User?       @relation(fields: [actorId], references: [id])

  @@index([accountId, createdAt])
}

// What 1s2u charges us per SMS part, per destination prefix. Longest prefix
// wins. A destination with no active row is refused, so we never send
// traffic whose cost we don't know.
model SmsRateCard {
  id               String   @id @default(cuid())
  // Country calling code or longer network prefix, digits only (e.g. "237").
  prefix           String   @unique
  label            String
  upstreamCostFcfa Int
  creditsPerPart   Int      @default(1)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Prepaid credit bundles we sell (the public price list).
model SmsPackage {
  id        String   @id @default(cuid())
  name      String
  credits   Int
  priceFcfa Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions SmsCreditTransaction[]
}

// ---------------------------------------------------------------------------
// SMS customer portal (/sms). Deliberately separate from `User` and Auth.js:
// a customer session must never be able to satisfy the /admin checks.
// ---------------------------------------------------------------------------

model SmsPortalUser {
  id           String    @id @default(cuid())
  accountId    String
  name         String
  // Stored lowercased.
  email        String    @unique
  // Null until the user sets one from an admin-issued access link.
  passwordHash String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account  SmsAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions SmsPortalSession[]
  tokens   SmsPortalToken[]

  @@index([accountId])
}

model SmsPortalSession {
  id        String   @id @default(cuid())
  userId    String
  // SHA-256 of the cookie value.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user SmsPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use "set your password" link, used both for first access and for
// resets. Issued by an admin (no email provider yet).
model SmsPortalToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user SmsPortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}
