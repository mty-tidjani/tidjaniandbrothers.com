# Postgres connection string. Local dev default matches docker-compose.yml.
DATABASE_URL="postgresql://spartiat:spartiat@localhost:5432/spartiat_ai"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by prisma/seed.ts, dev/staging only)
ADMIN_EMAIL="admin@spartiat-it.com"
ADMIN_SEED_PASSWORD="change-me-before-seeding"
