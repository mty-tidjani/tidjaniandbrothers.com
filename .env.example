# Postgres connection string. Local dev default matches docker-compose.yml.
DATABASE_URL=<PUSTGRES_URL>

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seed admin account (used by prisma/seed.ts, dev/staging only)
ADMIN_EMAIL=""
ADMIN_SEED_PASSWORD=""
